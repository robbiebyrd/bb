MSG_BUFFER_SIZE=1024000
LOG_LEVEL=debug

INFLUX_HOST="http://localhost:8181"
INFLUX_TOKEN="apiv3_v..."
INFLUX_TOKEN_FILE=./config/influxdb/token.json
INFLUX_DATABASE=can_data
INFLUX_MAX_WRITE_LINES=2500
INFLUX_FLUSH_TIME=100
INFLUX_MAX_CONNECTIONS=30

MQTT_HOST=localhost:1883
MQTT_CLIENT_ID=bb_app
MQTT_TOPIC=bb_app
MQTT_QOS=0
MQTT_SHADOW_COPY=false
MQTT_DEDUPE=true
MQTT_DEDUPE_TIMEOUT_MS=1000
MQTT_DEDUPE_IDS=1,2,3

CSV_CAN_OUTPUT_FILE="./output-messages.csv"
CSV_SIGNAL_OUTPUT_FILE="./output-signals.csv"
CSV_OUTPUT_HEADERS=true

CRTD_CAN_OUTPUT_FILE="./output-messages.crtd"
CRTD_SIGNAL_OUTPUT_FILE="./output-signals.crtd"

# Prometheus exporter (empty = disabled). Prometheus scrapes this address.
# Bind to loopback to avoid accidental public exposure.
PROMETHEUS_LISTEN_ADDR=127.0.0.1:9091
PROMETHEUS_PATH=/metrics

# SIM_RATE: fixed emit interval in nanoseconds (ns). Ignored if SIM_RATE_MIN/MAX are set.
SIM_RATE=10000
# SIM_RATE_MIN / SIM_RATE_MAX: randomise emit interval in nanoseconds. Both must be set; MIN < MAX.
#SIM_RATE_MIN=50000
#SIM_RATE_MAX=200000

CAN_INTERFACE_SEPARATOR="-"

# ============================================================================
# Interfaces (frame sources)
# ----------------------------------------------------------------------------
# Each interface is indexed: INTERFACE_<n>_<KEY>, starting at 0. A bare
# INTERFACE_NAME (no index) is ignored. With no interfaces set, CANtou starts a
# single "sim" interface. Prefer a JSON config (CONFIG_FILE / --config) for many
# interfaces — see config.example.json.
#
# Common per-interface keys (all networks):
#   _NAME   label (required)
#   _NET    can | sim | slcan | playback | elm327 | stn
#   _URI    device path / address / file, meaning depends on _NET (see below)
#   _DBC    comma-separated DBC file paths for signal decoding
#   _SIGNAL_FILTER / _SIGNAL_FILTER_OP / _SIGNAL_FILTER_MODE  (see below)
# ============================================================================

# --- sim: built-in synthetic frame generator (no hardware; all OSes) ---------
INTERFACE_0_NAME="CAN C"
INTERFACE_0_NET=sim
INTERFACE_0_URI=can0

INTERFACE_1_NAME="CAN IHS"
INTERFACE_1_NET=sim
INTERFACE_1_URI=can1

INTERFACE_2_NAME="CAN LOW"
INTERFACE_2_NET=sim
INTERFACE_2_URI=can2

# --- can: Linux SocketCAN (kernel CAN interface; Linux only) -----------------
# _NAME must be the kernel interface (e.g. can0); bring it up first, e.g.:
#   sudo ip link set can0 up type can bitrate 500000
#INTERFACE_3_NAME=can0
#INTERFACE_3_NET=can
#INTERFACE_3_URI=can0
#INTERFACE_3_DBC=./dbc/bertha.dbc             # optional: decode frames to signals

# --- slcan: serial-line CAN adapter, e.g. CANable (Linux only) ---------------
# _URI is the serial device; defaults to 115200 baud / 500 kbit/s CAN.
#INTERFACE_4_NAME="CANable"
#INTERFACE_4_NET=slcan
#INTERFACE_4_URI=/dev/ttyACM0

# --- playback: replay a recorded log, preserving timing (all OSes) -----------
# _URI is the log file; format auto-detected (.log, .asc, .trc, .mf4).
#INTERFACE_5_NAME="Replay"
#INTERFACE_5_NET=playback
#INTERFACE_5_URI=./captures/drive.asc
#INTERFACE_5_LOOP=true                        # restart from the top when exhausted
#INTERFACE_5_DBC=./dbc/bertha.dbc

# --- Per-interface signal filtering (any network with a DBC) -----------------
# Rules are field:op:value (field: signal|message; op: eq, neq, contains,
# notcontains, startswith, notstartswith, endswith, notendswith).
#INTERFACE_0_SIGNAL_FILTER=signal:contains:UNUSED,message:startswith:UNKNOWN_
#INTERFACE_0_SIGNAL_FILTER_OP=or              # combine rules: and (default) | or
#INTERFACE_0_SIGNAL_FILTER_MODE=exclude       # exclude (default) | include

# --- OBD-II adapter examples (ELM327 / STN, e.g. OBDLink MX+) ---
# One-time Bluetooth pairing on Linux:
#   bluetoothctl pair AA:BB:CC:DD:EE:FF && bluetoothctl trust AA:BB:CC:DD:EE:FF
# On Linux use rfcomm://<MAC> (no `rfcomm bind`). On macOS/Windows pair via the OS
# and use the serial device path instead (macOS: /dev/cu.*, Windows: COMx).

# Passive CAN sniffing, hardware-filtered to a few IDs (hex):
#INTERFACE_6_NAME="OBD Monitor"
#INTERFACE_6_NET=stn                          # stn (OBDLink MX+) or elm327
#INTERFACE_6_URI=rfcomm://AA:BB:CC:DD:EE:FF
#INTERFACE_6_OBD_MODE=monitor                 # passive sniff (default)
#INTERFACE_6_OBD_PROTOCOL=6                   # 6=ISO15765 11/500 (default), 7=29/500, 0=auto
#INTERFACE_6_OBD_HW_FILTER=7E8,1C4,244            # hex CAN IDs to pass in hardware (empty=all)

# Active OBD-II PID polling (request/response on an interval):
#INTERFACE_7_NAME="OBD Poll"
#INTERFACE_7_NET=elm327
#INTERFACE_7_URI=/dev/rfcomm0
#INTERFACE_7_OBD_MODE=poll
#INTERFACE_7_OBD_PIDS=010C,010D,0105          # mode+PID hex: RPM, speed, coolant temp
#INTERFACE_7_OBD_POLL_MS=500

# Hybrid (STN only): sniff the bus AND firmware-poll PIDs concurrently, gap-free:
#INTERFACE_8_NAME="OBD Hybrid"
#INTERFACE_8_NET=stn
#INTERFACE_8_URI=rfcomm://AA:BB:CC:DD:EE:FF
#INTERFACE_8_OBD_MODE=hybrid
#INTERFACE_8_OBD_PIDS=010C,010D
#INTERFACE_8_OBD_HW_FILTER=7E8,7E9,7EA,1C4,244    # include 7E8-7EF so poll replies pass!
#INTERFACE_8_OBD_POLL_MS=1000
#INTERFACE_8_OBD_PORT_BAUD=115200                 # nominal over Bluetooth
#INTERFACE_8_DBC=./dbc/bertha.dbc             # optional: decode frames into named signals

